# ==============================================
# TEMPLATE .ENV UNTUK CPANEL HOSTING
# ==============================================
# Copy isi file ini ke file .env di cPanel
# Ganti semua nilai yang ditandai dengan GANTI_INI

# Application Configuration
APP_NAME="LapangKuy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://GANTI_INI_DENGAN_DOMAIN_ANDA.com
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# Logging Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration
# WAJIB DIGANTI dengan informasi database cPanel Anda
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=GANTI_INI_username_lapangkuy
DB_USERNAME=GANTI_INI_username_dbuser  
DB_PASSWORD=GANTI_INI_password_database

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache Configuration
CACHE_STORE=database
CACHE_PREFIX=

# Redis (jika tidak tersedia di hosting, biarkan default)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
# Sesuaikan dengan email hosting Anda
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@GANTI_INI_DENGAN_DOMAIN_ANDA.com"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans Payment Configuration
# WAJIB DIGANTI dengan key production dari dashboard Midtrans
MIDTRANS_SERVER_KEY=GANTI_INI_SB-Mid-server-xxxxxxxxxxxxxxxx  
MIDTRANS_CLIENT_KEY=GANTI_INI_SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# AWS Configuration (jika tidak digunakan, biarkan kosong)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"

# ==============================================
# LANGKAH SETELAH COPY KE CPANEL:
# ==============================================
# 1. Ganti semua nilai yang bertanda GANTI_INI
# 2. Generate APP_KEY dengan: php artisan key:generate
# 3. Atau generate manual di: https://generate-random.org/laravel-key-generator
# 4. Test akses website
# 5. Cek error logs jika ada masalah
